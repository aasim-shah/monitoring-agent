{
  "name": "@pcp/tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint smoke e2e agent-e2e",
    "test:smoke": "vitest run",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:agent-e2e": "vitest run -c agent-e2e/vitest.config.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "@playwright/test": "1.64.1"
  }
}
