{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "@pcp/web#typecheck": {
      "dependsOn": ["^build", "@pcp/web#build"]
    },
    "test:live": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["LIVE_*"]
    }
  }
}
