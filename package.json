{
  "name": "product-control-plane",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:repo": "node --test 'scripts/__tests__/*.test.mjs'",
    "format:check": "prettier --check .",
    "lint:openapi": "spectral lint docs/architecture/openapi-v1.yaml --fail-severity error",
    "test:go": "scripts/go.sh test ./apps/opamp-server/... ./apps/ingest-gateway/... ./apps/installer-runner/... ./packages/go-platform/... ./packages/agent-protocol/go/... ./agents/host-agent-go/...",
    "vet:go": "scripts/go.sh vet ./apps/opamp-server/... ./apps/ingest-gateway/... ./apps/installer-runner/... ./packages/go-platform/... ./packages/agent-protocol/go/... ./agents/host-agent-go/...",
    "test:smoke": "pnpm --filter @pcp/tests test:smoke",
    "format": "prettier --write .",
    "test:e2e": "pnpm --filter @pcp/tests test:e2e",
    "test:agent-e2e": "pnpm --filter @pcp/tests test:agent-e2e",
    "audit:prod": "pnpm audit --prod --audit-level high"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@stoplight/spectral-cli": "6.15.1",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "prettier": "3.6.2",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.40.0",
    "vitest": "4.1.12",
    "yaml": "2.8.4"
  },
  "pnpm": {
    "overrides": {
      "fastify": "5.12.7",
      "next>postcss": "8.5.31",
      "deepmerge-ts": "8.0.0",
      "dockerode>uuid": "11.1.1"
    }
  }
}
