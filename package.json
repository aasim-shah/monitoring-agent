{
  "name": "product-control-plane",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:repo": "node --test 'scripts/__tests__/*.test.mjs'",
    "format:check": "prettier --check .",
    "lint:openapi": "spectral lint docs/architecture/openapi-v1.yaml --fail-severity error",
    "test:go": "scripts/go.sh test ./apps/opamp-server/... ./apps/ingest-gateway/... ./packages/go-platform/... ./packages/agent-protocol/go/...",
    "vet:go": "scripts/go.sh vet ./apps/opamp-server/... ./apps/ingest-gateway/... ./packages/go-platform/... ./packages/agent-protocol/go/...",
    "test:smoke": "pnpm --filter @pcp/tests test:smoke",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@stoplight/spectral-cli": "6.15.1",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "prettier": "3.6.2",
    "turbo": "2.5.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.40.0",
    "vitest": "3.2.7",
    "yaml": "2.8.4"
  }
}
