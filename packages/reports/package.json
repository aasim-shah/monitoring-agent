{
  "name": "@pcp/reports",
  "version": "0.0.0",
  "private": true,
  "description": "Daily reports: DST-safe windows, deterministic snapshots, validated AI narrative, and rendering (M15, WB-15).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "default": "./dist/render.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@pcp/ai-orchestrator": "workspace:*",
    "luxon": "3.7.2"
  },
  "devDependencies": {
    "@types/luxon": "3.7.1",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
