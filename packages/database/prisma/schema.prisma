  reports GeneratedReport[]

  @@index([organizationId, productId])
  @@index([nextRunAt])
  @@map("report_schedules")
}

/// One version of a report for a local date (BR-15-04/06); the snapshot holds every number.
model GeneratedReport {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String                @map("organization_id") @db.Uuid
  productId       String                @map("product_id") @db.Uuid
  scheduleId      String?               @map("schedule_id") @db.Uuid
  localDate       DateTime              @map("local_date") @db.Date
  version         Int                   @default(1)
  windowStart     DateTime              @map("window_start") @db.Timestamptz(6)
  windowEnd       DateTime              @map("window_end") @db.Timestamptz(6)
