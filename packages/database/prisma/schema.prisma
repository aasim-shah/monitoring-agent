  organizationId String       @map("organization_id") @db.Uuid
  runId          String       @map("run_id") @db.Uuid
  tool           String
  input          Json
  status         AiToolStatus
  evidenceId     String?      @map("evidence_id")
  durationMs     Int          @default(0) @map("duration_ms")
