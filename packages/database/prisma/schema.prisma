  @@map("action_execution_status")
}

/// Which operational action may run where, approved by whom (WB-16 UC-16-01). Disabled by default (BR-16-01).
model ActionPolicy {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  environmentId   String   @map("environment_id") @db.Uuid
  capability      String
  enabled         Boolean  @default(false)
  approverRoles   String[] @default([]) @map("approver_roles")
  requireApproval Boolean  @default(true) @map("require_approval")
  /// Allowlists for the capability: units, workflows with refs, zones.
  settings        Json     @default("{}")
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product     Product     @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)
  environment Environment @relation(fields: [organizationId, environmentId], references: [organizationId, id], onDelete: Cascade)

  @@unique([productId, environmentId, capability])
  @@map("action_policies")
}

/// One proposed operational action and its lifecycle (spec §13.5).
model ActionRequest {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String              @map("organization_id") @db.Uuid
  productId         String              @map("product_id") @db.Uuid
  environmentId     String              @map("environment_id") @db.Uuid
  capability        String
  target            Json
  /// One action per target at a time (BR-16-06), e.g. host.restart_service:<agentId>:<unit>.
  targetKey         String              @map("target_key")
  params            Json                @default("{}")
  status            ActionRequestStatus @default(proposed)
  reason            String?
  impact            Json                @default("{}")
  proposedByAi      Boolean             @default(false) @map("proposed_by_ai")
  requestedByUserId String?             @map("requested_by_user_id") @db.Uuid
  idempotencyKey    String              @map("idempotency_key")
  incidentId        String?             @map("incident_id") @db.Uuid
  expiresAt         DateTime            @map("expires_at") @db.Timestamptz(6)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  product     Product           @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)
  environment Environment       @relation(fields: [organizationId, environmentId], references: [organizationId, id], onDelete: Cascade)
  approvals   ActionApproval[]
  executions  ActionExecution[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, productId, createdAt])
  @@index([status, expiresAt])
  @@map("action_requests")
}

model ActionApproval {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  requestId      String   @map("request_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  /// approve or reject.
  decision       String
  note           String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  request ActionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, userId])
  @@map("action_approvals")
}

/// One attempt to carry out an approved request, with its verification (BR-16-08).
model ActionExecution {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  requestId      String                @map("request_id") @db.Uuid
  targetKey      String                @map("target_key")
  /// Set to target_key while running, cleared when finished: one running execution per target (BR-16-06).
  runningKey     String?               @unique @map("running_key")
  /// agent (through pcp-helper) or platform (provider API).
  location       String
  adapter        String
  adapterVersion String                @map("adapter_version")
  agentTaskId    String?               @map("agent_task_id") @db.Uuid
  status         ActionExecutionStatus @default(running)
  startedAt      DateTime              @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime?             @map("finished_at") @db.Timestamptz(6)
  result         Json?
  verification   Json?
  error          String?

  request ActionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([organizationId, requestId])
  @@map("action_executions")
}

/// One webhook delivery's metadata (WB-06 UC-06-10); payloads are never stored (BR-06-05).
model WebhookDelivery {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  connectionId   String   @map("connection_id") @db.Uuid
  provider       String
  deliveryId     String   @map("delivery_id")
  eventType      String   @map("event_type")
  /// processed, duplicate, rejected, or ignored.
  result         String
  detail         String?
  receivedAt     DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  connection Connection @relation(fields: [organizationId, connectionId], references: [organizationId, id], onDelete: Cascade)

  @@unique([provider, deliveryId])
  @@index([organizationId, connectionId, receivedAt(sort: Desc)])
  @@map("webhook_deliveries")
}

/// A deployment, failed workflow, release, push, DNS change, or security event from a provider (spec §13.4).
model ChangeEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  connectionId   String   @map("connection_id") @db.Uuid
  productId      String?  @map("product_id") @db.Uuid
  provider       String
  kind           String
  title          String
  url            String?
  actor          String?
  externalId     String   @map("external_id")
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(6)
  attributes     Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  connection Connection @relation(fields: [organizationId, connectionId], references: [organizationId, id], onDelete: Cascade)

  @@unique([connectionId, kind, externalId])
  @@index([organizationId, occurredAt(sort: Desc)])
  @@map("change_events")
}

/// What a connector's last discovery found (zones, repositories, targets, dashboards).
model ConnectionInventoryItem {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  connectionId   String   @map("connection_id") @db.Uuid
  resourceType   String   @map("resource_type")
  externalId     String   @map("external_id")
  name           String
  attributes     Json     @default("{}")
  observedAt     DateTime @default(now()) @map("observed_at") @db.Timestamptz(6)

  connection Connection @relation(fields: [organizationId, connectionId], references: [organizationId, id], onDelete: Cascade)

  @@unique([connectionId, resourceType, externalId])
  @@index([organizationId, connectionId])
  @@map("connection_inventory")
}

/// One daily KPI value from a provider (GA4, Search Console, Play vitals). A failed window has no row,
/// never a zero (WB-09 BR-09-05); `partial` marks a day the provider is still processing.
model MetricAggregate {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  connectionId   String   @map("connection_id") @db.Uuid
  resourceType   String   @map("resource_type")
  externalId     String   @map("external_id")
  metric         String
  /// A breakdown value (e.g. a channel group), or '' for the total.
  dimension      String   @default("")
  day            DateTime @db.Date
  value          Float?
  /// complete or partial.
  completeness   String
  fetchedAt      DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  connection Connection @relation(fields: [organizationId, connectionId], references: [organizationId, id], onDelete: Cascade)

  @@unique([connectionId, resourceType, externalId, metric, dimension, day])
  @@index([organizationId, connectionId, day])
  @@map("metric_aggregates")
}

/// A tenant data export (WB-17 UC-17-09): JSON archive without secrets, downloadable for 24 h.
model TenantExport {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  requestedByUserId String?   @map("requested_by_user_id") @db.Uuid
  /// queued, ready, failed, or expired.
  status            String
  /// gzip-compressed JSON; cleared when the link expires.
  archive           Bytes?
  sizeBytes         Int?      @map("size_bytes")
  error             String?
  expiresAt         DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("tenant_exports")
}

/// What remains of a purged organization: who, when, and how many rows were removed (legal record).
model DeletedOrganization {
  id                  String   @id @db.Uuid
  name                String
  deletionRequestedAt DateTime @map("deletion_requested_at") @db.Timestamptz(6)
  purgedAt            DateTime @default(now()) @map("purged_at") @db.Timestamptz(6)
  summary             Json     @default("{}")

  @@map("deleted_organizations")
}

/// One minute of a tenant's telemetry as the ingest gateway saw it (M10.6, spec §11.6).
model TelemetryUsage {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String   @map("organization_id") @db.Uuid
  minute                DateTime @db.Timestamptz(6)
  /// Distinct series admitted this hour (a level, not a sum).
  activeSeries          Int      @map("active_series")
  samples               BigInt
  refusedSeriesRequests Int      @default(0) @map("refused_series_requests")
  refusedRateRequests   Int      @default(0) @map("refused_rate_requests")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, minute])
  @@map("telemetry_usage")
}

/// A live boost: one pack on one agent collects every 5 s until expires_at (M10.7, BR-11-08).
model AgentLiveBoost {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  agentId         String   @map("agent_id") @db.Uuid
  packId          String   @map("pack_id")
  taskId          String?  @map("task_id") @db.Uuid
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, expiresAt])
  @@map("agent_live_boosts")
}
