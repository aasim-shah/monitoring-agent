// Product Control Plane — identity and tenancy schema (master plan M2.1).
// Tables are snake_case plural; models are PascalCase singular (`@@map`).
// Row-level security, roles, and SECURITY DEFINER functions are defined in the
// SQL migrations, not here (Prisma does not model them).

generator client {
  provider      = "prisma-client-js"
  output        = "../generated/client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberRole {
  owner
  admin
  operator
  analyst
  viewer

  @@map("member_role")
}

enum EmailTokenKind {
  verify
  reset

  @@map("email_token_kind")
}

enum ConnectionStatus {
  draft
  pending_auth
  pending_validation
  connected
  degraded
  disconnected
  revoked

  @@map("connection_status")
}

enum ExecutionLocation {
  cloud
  private

  @@map("execution_location")
}

enum SyncKind {
  validate
  discover
  sync

  @@map("sync_kind")
}

enum RunStatus {
  queued
  running
  succeeded
  failed
  cancelled

  @@map("run_status")
}

enum JobStatus {
  running
  succeeded
  failed
  dead_letter

  @@map("job_status")
}

// ---------- Global identity (no tenant column, no RLS) ----------

model User {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Stored lowercase.
  email            String    @unique
  passwordHash     String?   @map("password_hash")
  emailVerifiedAt  DateTime? @map("email_verified_at") @db.Timestamptz(6)
  googleSub        String?   @unique @map("google_sub")
  /// Serialized EncryptedSecret (@pcp/secrets); AAD "user:<id>:mfa".
  mfaSecret        String?   @map("mfa_secret")
  mfaPendingSecret String?   @map("mfa_pending_secret")
  mfaEnabledAt     DateTime? @map("mfa_enabled_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  sessions      Session[]
  emailTokens   EmailToken[]
  recoveryCodes MfaRecoveryCode[]
  memberships   OrganizationMember[]

  @@map("users")
}

model Session {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  mfaVerified Boolean   @default(false) @map("mfa_verified")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model EmailToken {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  kind      EmailTokenKind
  tokenHash String         @unique @map("token_hash")
  expiresAt DateTime       @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?      @map("used_at") @db.Timestamptz(6)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@map("email_tokens")
}

model MfaRecoveryCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("mfa_recovery_codes")
}

// ---------- Tenant tables (RLS forced) ----------

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  timezone  String   @default("UTC")
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Deletion requested (WB-17 UC-17-09): members lose access; owners may cancel until the purge.
  deletionRequestedAt       DateTime? @map("deletion_requested_at") @db.Timestamptz(6)
  deletionScheduledFor      DateTime? @map("deletion_scheduled_for") @db.Timestamptz(6)
  deletionRequestedByUserId String?   @map("deletion_requested_by_user_id") @db.Uuid

  members        OrganizationMember[]
  invitations    Invitation[]
  products       Product[]
  teams          Team[]
  auditLogs      AuditLog[]
  connections    Connection[]
  jobDefinitions JobDefinition[]
  jobExecutions  JobExecution[]
  alertRules     AlertRule[]
  channels       NotificationChannel[]
  aiSettings     AiSettings?
  exports        TenantExport[]
  usage          TelemetryUsage[]
  liveBoosts     AgentLiveBoost[]

  @@map("organizations")
}

model OrganizationMember {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  userId         String     @map("user_id") @db.Uuid
  role           MemberRole
  /// true = all products; false = only productIds.
  allProducts    Boolean    @default(true) @map("all_products")
  productIds     String[]   @default([]) @map("product_ids") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@index([userId])
  @@map("organization_members")
}

model Invitation {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String     @map("organization_id") @db.Uuid
  /// Stored lowercase.
  email           String
  role            MemberRole
  allProducts     Boolean    @default(true) @map("all_products")
  productIds      String[]   @default([]) @map("product_ids") @db.Uuid
  tokenHash       String     @unique @map("token_hash")
  invitedByUserId String     @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime   @map("expires_at") @db.Timestamptz(6)
  acceptedAt      DateTime?  @map("accepted_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("invitations")
}

model Product {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String?
  /// Discovery hints, not proof of ownership.
  domains        String[] @default([])
  repositories   String[] @default([])
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization    Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  environments    Environment[]
  resourceScopes  ConnectionResourceScope[]
  assets          ProductAsset[]
  discoveryRuns   DiscoveryRun[]
  alertRules      AlertRule[]
  conversations   AiConversation[]
  websites        WebsiteMonitor[]
  reportSchedules ReportSchedule[]
  reports         GeneratedReport[]
  actionPolicies  ActionPolicy[]
  actionRequests  ActionRequest[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@map("products")
}

model Environment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product          Product           @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)
  agentEnrollments AgentEnrollment[]
  agents           Agent[]
  actionPolicies   ActionPolicy[]
  actionRequests   ActionRequest[]

  @@unique([organizationId, id])
  @@unique([productId, name])
  @@map("environments")
}

model Team {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@map("teams")
}

/// Append-only: pcp_app has no UPDATE or DELETE privilege.
model AuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorType      String   @map("actor_type")
  actorId        String?  @map("actor_id")
  action         String
  targetType     String   @map("target_type")
  targetId       String?  @map("target_id")
  metadata       Json     @default("{}")
  requestId      String?  @map("request_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ---------- Connections (master plan M4) ----------

model Connection {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String            @map("organization_id") @db.Uuid
  provider          String
  displayName       String            @map("display_name")
  executionLocation ExecutionLocation @map("execution_location")
  status            ConnectionStatus  @default(draft)
  /// connection reason (reauthorization_required, rate_limited, permission_denied, provider_unavailable) or null
  statusReason      String?           @map("status_reason")
  /// Non-secret configuration only.
  config            Json              @default("{}")
  createdByUserId   String?           @map("created_by_user_id") @db.Uuid
  /// OAuth connections (Google): the scopes the provider actually granted (BR-08-03).
  grantedScopes     String[]          @default([]) @map("granted_scopes")
  /// OAuth connections: the account that granted access, shown as "Connected as" (BR-08-07).
  accountEmail      String?           @map("account_email")
  lastValidatedAt   DateTime?         @map("last_validated_at") @db.Timestamptz(6)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  secret       ConnectionSecret?
  scopes       ConnectionResourceScope[]
  health       ConnectionHealth[]
  syncRuns     SyncRun[]
  deliveries   WebhookDelivery[]
  changeEvents ChangeEvent[]
  inventory    ConnectionInventoryItem[]
  metrics      MetricAggregate[]

  @@unique([organizationId, id])
  @@index([organizationId, provider])
  @@map("connections")
}

/// Envelope-encrypted credentials (ADR 0004). Deleting the row crypto-shreds them.
model ConnectionSecret {
  connectionId   String    @id @map("connection_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  /// Serialized EncryptedSecret; AAD "<organizationId>:<connectionId>".
  ciphertext     String
  keyVersion     Int       @map("key_version")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  rotatedAt      DateTime? @map("rotated_at") @db.Timestamptz(6)

  connection Connection @relation(fields: [organizationId, connectionId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, connectionId])
  @@map("connection_secrets")
}

model ConnectionResourceScope {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  connectionId   String   @map("connection_id") @db.Uuid
  externalId     String   @map("external_id")
  resourceType   String   @map("resource_type")
  name           String
  productId      String   @map("product_id") @db.Uuid
  /// Validated in the service (an optional composite foreign key is not expressible in Prisma).
  environmentId  String?  @map("environment_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  connection Connection @relation(fields: [organizationId, connectionId], references: [organizationId, id], onDelete: Cascade)
  product    Product    @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)

  @@unique([connectionId, externalId, productId])
  @@index([organizationId, productId])
  @@map("connection_resource_scopes")
}

model ConnectionHealth {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  connectionId   String   @map("connection_id") @db.Uuid
  checkedAt      DateTime @default(now()) @map("checked_at") @db.Timestamptz(6)
  ok             Boolean
  reason         String?
  detail         String?

  connection Connection @relation(fields: [organizationId, connectionId], references: [organizationId, id], onDelete: Cascade)

  @@index([connectionId, checkedAt(sort: Desc)])
  @@map("connection_health")
}

model SyncRun {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  connectionId   String    @map("connection_id") @db.Uuid
  kind           SyncKind
  status         RunStatus @default(queued)
  jobId          String?   @map("job_id")
  startedAt      DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(6)
  errorCode      String?   @map("error_code")
  /// Redacted before storage.
  errorMessage   String?   @map("error_message")
  items          Int?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  connection Connection @relation(fields: [organizationId, connectionId], references: [organizationId, id], onDelete: Cascade)

  @@index([connectionId, createdAt(sort: Desc)])
  @@map("sync_runs")
}

// ---------- Jobs (master plan M4.4) ----------

model JobDefinition {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  kind           String
  entityId       String   @map("entity_id") @db.Uuid
  everySeconds   Int      @map("every_seconds")
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, kind, entityId])
  @@map("job_definitions")
}

model JobExecution {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  jobId          String    @map("job_id")
  kind           String
  status         JobStatus
  attempts       Int
  /// Redacted before storage.
  error          String?
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, jobId])
  @@map("job_executions")
}

enum AgentType {
  host
  private_worker

  @@map("agent_type")
}

/// Stored status; `degraded` and `stale` are derived from heartbeats at read time.
enum AgentStatus {
  active
  revoked

  @@map("agent_status")
}

enum AgentTaskStatus {
  queued
  delivered
  succeeded
  failed
  expired

  @@map("agent_task_status")
}

enum StreamSessionStatus {
  open
  closed

  @@map("stream_session_status")
}

model AgentEnrollment {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  productId       String    @map("product_id") @db.Uuid
  environmentId   String    @map("environment_id") @db.Uuid
  agentType       AgentType @default(host) @map("agent_type")
  /// HMAC-SHA-256 of the token with the server pepper; the token itself is never stored.
  tokenHash       String    @unique @map("token_hash")
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  maxUses         Int       @default(1) @map("max_uses")
  uses            Int       @default(0)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  environment Environment @relation(fields: [organizationId, environmentId], references: [organizationId, id], onDelete: Cascade)
  agents      Agent[]

  @@unique([organizationId, id])
  @@index([environmentId, createdAt(sort: Desc)])
  @@map("agent_enrollments")
}

model Agent {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String      @map("organization_id") @db.Uuid
  productId        String      @map("product_id") @db.Uuid
  environmentId    String      @map("environment_id") @db.Uuid
  enrollmentId     String      @map("enrollment_id") @db.Uuid
  agentType        AgentType   @map("agent_type")
  status           AgentStatus @default(active)
  hostname         String
  machineId        String      @map("machine_id")
  os               String
  arch             String
  agentVersion     String      @map("agent_version")
  capabilities     String[]    @default([])
  policyVersion    Int         @default(1) @map("policy_version")
  lastHeartbeatAt  DateTime?   @map("last_heartbeat_at") @db.Timestamptz(6)
  lastSequence     BigInt?     @map("last_sequence")
  clockSkewSeconds Int?        @map("clock_skew_seconds")
  /// Egress IP of the agent as the edge proxy saw it (dns-to-host correlation, M9).
  lastSeenIp       String?     @map("last_seen_ip")
  revokedAt        DateTime?   @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  enrollment     AgentEnrollment       @relation(fields: [organizationId, enrollmentId], references: [organizationId, id], onDelete: Cascade)
  environment    Environment           @relation(fields: [organizationId, environmentId], references: [organizationId, id], onDelete: Cascade)
  credentials    AgentCredential[]
  publicKeys     AgentPublicKey[]
  heartbeats     AgentHeartbeat[]
  tasks          AgentTask[]
  streamSessions AgentStreamSession[]
  inventory      AgentInventory?
  packs          AgentPackAssignment[]

  @@unique([organizationId, id])
  @@index([organizationId, productId])
  @@index([machineId])
  @@map("agents")
}

model AgentCredential {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  agentId           String    @map("agent_id") @db.Uuid
  /// SHA-256 of the certificate DER, lowercase hex (what Caddy forwards).
  fingerprintSha256 String    @unique @map("fingerprint_sha256")
  serial            String
  notAfter          DateTime  @map("not_after") @db.Timestamptz(6)
  /// Set when the agent rotates; the old certificate stays valid for 1 h after this.
  supersededAt      DateTime? @map("superseded_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  agent Agent @relation(fields: [organizationId, agentId], references: [organizationId, id], onDelete: Cascade)

  @@index([agentId])
  @@map("agent_credentials")
}

model AgentPublicKey {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  agentId        String   @map("agent_id") @db.Uuid
  /// `x25519` (pack credential sealing, D24).
  kind           String
  publicKey      String   @map("public_key")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  agent Agent @relation(fields: [organizationId, agentId], references: [organizationId, id], onDelete: Cascade)

  @@unique([agentId, kind])
  @@map("agent_public_keys")
}

model AgentHeartbeat {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  agentId        String   @map("agent_id") @db.Uuid
  receivedAt     DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  sentAt         DateTime @map("sent_at") @db.Timestamptz(6)
  sequence       BigInt
  health         String
  queueDepth     Int      @map("queue_depth")
  agentVersion   String   @map("agent_version")
  policyVersion  Int      @map("policy_version")

  agent Agent @relation(fields: [organizationId, agentId], references: [organizationId, id], onDelete: Cascade)

  @@index([agentId, receivedAt(sort: Desc)])
  @@map("agent_heartbeats")
}

model AgentTask {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String          @map("organization_id") @db.Uuid
  agentId           String          @map("agent_id") @db.Uuid
  type              String
  payload           Json            @default("{}")
  resourceScope     Json            @default("{}") @map("resource_scope")
  expiresAt         DateTime        @map("expires_at") @db.Timestamptz(6)
  maxRuntimeSeconds Int             @map("max_runtime_seconds")
  maxResponseBytes  Int             @map("max_response_bytes")
  approvalId        String?         @map("approval_id") @db.Uuid
  signature         String
  status            AgentTaskStatus @default(queued)
  deliveredAt       DateTime?       @map("delivered_at") @db.Timestamptz(6)
  createdByUserId   String?         @map("created_by_user_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  agent          Agent                @relation(fields: [organizationId, agentId], references: [organizationId, id], onDelete: Cascade)
  result         AgentTaskResult?
  streamSessions AgentStreamSession[]

  @@unique([organizationId, id])
  @@index([agentId, status, expiresAt])
  @@map("agent_tasks")
}

model AgentTaskResult {
  taskId         String   @id @map("task_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  agentId        String   @map("agent_id") @db.Uuid
  /// `succeeded` or `failed`.
  status         String
  result         Json?
  error          String?
  receivedAt     DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  task AgentTask @relation(fields: [organizationId, taskId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, taskId])
  @@map("agent_task_results")
}

model AgentStreamSession {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  agentId        String              @map("agent_id") @db.Uuid
  taskId         String              @map("task_id") @db.Uuid
  status         StreamSessionStatus @default(open)
  expiresAt      DateTime            @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  agent Agent     @relation(fields: [organizationId, agentId], references: [organizationId, id], onDelete: Cascade)
  task  AgentTask @relation(fields: [organizationId, taskId], references: [organizationId, id], onDelete: Cascade)

  @@map("agent_stream_sessions")
}

enum PackStatus {
  pending
  applied
  failed
  removing

  @@map("pack_status")
}

/// Latest discovery snapshot reported by an agent (services, listeners, warnings).
model AgentInventory {
  agentId        String   @id @map("agent_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  collectedAt    DateTime @map("collected_at") @db.Timestamptz(6)
  services       Json     @default("[]")
  listeners      Json     @default("[]")
  warnings       Json     @default("[]")

  agent Agent @relation(fields: [organizationId, agentId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, agentId])
  @@map("agent_inventories")
}

/// A monitoring pack enabled on an agent. `sealed_credentials` holds ciphertext only the
/// agent can open and is cleared once the agent acknowledges (BR-11-03).
model AgentPackAssignment {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String     @map("organization_id") @db.Uuid
  agentId           String     @map("agent_id") @db.Uuid
  packId            String     @map("pack_id")
  settings          Json       @default("{}")
  sealedCredentials String?    @map("sealed_credentials")
  status            PackStatus @default(pending)
  statusMessage     String?    @map("status_message")
  policyVersion     Int        @map("policy_version")
  appliedAt         DateTime?  @map("applied_at") @db.Timestamptz(6)
  createdByUserId   String?    @map("created_by_user_id") @db.Uuid
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  agent Agent @relation(fields: [organizationId, agentId], references: [organizationId, id], onDelete: Cascade)

  @@unique([agentId, packId])
  @@map("agent_pack_assignments")
}

// ===== M9: asset graph (spec §10, WB-10) =====

enum AssetType {
  host
  service
  database
  website
  domain
  repository
  worker
  external

  @@map("asset_type")
}

enum AssetLifecycle {
  discovered
  active
  unreachable
  missing
  retired
  manually_managed

  @@map("asset_lifecycle")
}

enum AssetSource {
  agent
  connector
  product_config
  manual

  @@map("asset_source")
}

enum RelationshipType {
  HOSTS
  ROUTES_TO
  CONNECTS_TO
  DEPENDS_ON
  DEPLOYS
  MONITORED_BY
  REPORTS_TO
  DEPLOYED_ON

  @@map("relationship_type")
}

enum Verification {
  proposed
  verified
  rejected
  drifted

  @@map("verification")
}

enum EvidenceKind {
  direct
  ip_match
  connection
  name
  manual
  contradiction

  @@map("evidence_kind")
}

enum AliasStatus {
  open
  merged
  kept_separate

  @@map("alias_status")
}

/// A canonical asset; identity_key is unique per organization and never shared across them (BR-10-01).
model Asset {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  assetType      AssetType      @map("asset_type")
  name           String
  lifecycle      AssetLifecycle @default(discovered)
  source         AssetSource
  /// `agent:<id>`, `agent:<id>/<pack>`, `connection:<id>`, `domain:<host>`, `manual:<uuid>`, `weak:<uuid>`.
  identityKey    String         @map("identity_key")
  /// Redacted before storage (BR-10-08).
  attributes     Json           @default("{}")
  firstSeenAt    DateTime       @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt     DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  missedRuns     Int            @default(0) @map("missed_runs")
  retiredAt      DateTime?      @map("retired_at") @db.Timestamptz(6)

  products     ProductAsset[]
  observations AssetObservation[]
  outgoing     AssetRelationship[] @relation("source")
  incoming     AssetRelationship[] @relation("target")
  aliases      AssetAlias[]        @relation("aliasAsset")
  candidateFor AssetAlias[]        @relation("aliasCandidate")

  @@unique([organizationId, id])
  @@unique([organizationId, identityKey])
  @@index([organizationId, assetType])
  @@map("assets")
}

/// Weak match (name/IP) awaiting review: never merged automatically (BR-10-02).
model AssetAlias {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String      @map("organization_id") @db.Uuid
  assetId          String      @map("asset_id") @db.Uuid
  candidateAssetId String      @map("candidate_asset_id") @db.Uuid
  reason           String
  status           AliasStatus @default(open)
  resolvedByUserId String?     @map("resolved_by_user_id") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  asset     Asset @relation("aliasAsset", fields: [organizationId, assetId], references: [organizationId, id], onDelete: Cascade)
  candidate Asset @relation("aliasCandidate", fields: [organizationId, candidateAssetId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("asset_aliases")
}

model AssetObservation {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  assetId        String      @map("asset_id") @db.Uuid
  source         AssetSource
  observedAt     DateTime    @default(now()) @map("observed_at") @db.Timestamptz(6)
  attributes     Json        @default("{}")

  asset Asset @relation(fields: [organizationId, assetId], references: [organizationId, id], onDelete: Cascade)

  @@index([assetId, observedAt(sort: Desc)])
  @@map("asset_observations")
}

/// One asset can belong to several products (UC-10-12, shared host).
model ProductAsset {
  organizationId String   @map("organization_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  assetId        String   @map("asset_id") @db.Uuid
  environmentId  String?  @map("environment_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)
  asset   Asset   @relation(fields: [organizationId, assetId], references: [organizationId, id], onDelete: Cascade)

  @@id([productId, assetId])
  @@index([organizationId, assetId])
  @@map("product_assets")
}

/// An evidence-backed edge (BR-10-05).
model AssetRelationship {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  sourceAssetId    String           @map("source_asset_id") @db.Uuid
  targetAssetId    String           @map("target_asset_id") @db.Uuid
  relationshipType RelationshipType @map("relationship_type")
  confidence       Decimal          @db.Decimal(3, 2)
  verification     Verification     @default(proposed)
  ruleId           String?          @map("rule_id")
  verifiedByUserId String?          @map("verified_by_user_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  source   Asset                  @relation("source", fields: [organizationId, sourceAssetId], references: [organizationId, id], onDelete: Cascade)
  target   Asset                  @relation("target", fields: [organizationId, targetAssetId], references: [organizationId, id], onDelete: Cascade)
  evidence RelationshipEvidence[]

  @@unique([organizationId, id])
  @@unique([sourceAssetId, targetAssetId, relationshipType])
  @@index([organizationId, verification])
  @@index([targetAssetId])
  @@map("asset_relationships")
}

model RelationshipEvidence {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  relationshipId String       @map("relationship_id") @db.Uuid
  kind           EvidenceKind
  detail         Json         @default("{}")
  observedAt     DateTime     @default(now()) @map("observed_at") @db.Timestamptz(6)

  relationship AssetRelationship @relation(fields: [organizationId, relationshipId], references: [organizationId, id], onDelete: Cascade)

  @@index([relationshipId, observedAt(sort: Desc)])
  @@map("relationship_evidence")
}

model DiscoveryRun {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  productId      String      @map("product_id") @db.Uuid
  source         AssetSource
  status         RunStatus   @default(running)
  startedAt      DateTime    @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime?   @map("completed_at") @db.Timestamptz(6)
  stats          Json        @default("{}")

  product Product @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)

  @@index([productId, source, startedAt(sort: Desc)])
  @@map("discovery_runs")
}

// ===== M12: alerting, incidents, notifications (spec §13, WB-13) =====

enum AlertSeverity {
  critical
  warning
  info

  @@map("alert_severity")
}

enum IncidentStatus {
  open
  acknowledged
  resolved

  @@map("incident_status")
}

enum IncidentEventKind {
  fired
  refired
  reopened
  acknowledged
  resolved
  notified
  suppressed
  escalated
  note

  @@map("incident_event_kind")
}

enum ChannelKind {
  email
  slack
  webhook

  @@map("channel_kind")
}

enum ChannelStatus {
  active
  broken

  @@map("channel_status")
}

enum DeliveryEvent {
  opened
  escalated
  resolved
  test

  @@map("delivery_event")
}

enum DeliveryStatus {
  pending
  sent
  failed
  dead

  @@map("delivery_status")
}

/// A rule built from a template (users never write PromQL); metric rules compile to vmalert.
model AlertRule {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  /// Null: organization-wide.
  productId       String?       @map("product_id") @db.Uuid
  name            String
  template        String
  params          Json          @default("{}")
  severity        AlertSeverity
  enabled         Boolean       @default(true)
  /// Set when a member deletes the rule: it stops evaluating, its incidents stay.
  archivedAt      DateTime?     @map("archived_at") @db.Timestamptz(6)
  createdByUserId String?       @map("created_by_user_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product?        @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)
  incidents    AlertIncident[]

  @@unique([organizationId, id])
  @@index([organizationId, productId])
  @@map("alert_rules")
}

model AlertIncident {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String         @map("organization_id") @db.Uuid
  productId            String?        @map("product_id") @db.Uuid
  ruleId               String         @map("rule_id") @db.Uuid
  fingerprint          String
  /// Equals fingerprint while unresolved, null once resolved: one open incident per fingerprint.
  openFingerprint      String?        @map("open_fingerprint")
  title                String
  severity             AlertSeverity
  status               IncidentStatus @default(open)
  labels               Json           @default("{}")
  correlation          Json           @default("{}")
  summary              String         @default("")
  startedAt            DateTime       @map("started_at") @db.Timestamptz(6)
  lastFiredAt          DateTime       @default(now()) @map("last_fired_at") @db.Timestamptz(6)
  acknowledgedAt       DateTime?      @map("acknowledged_at") @db.Timestamptz(6)
  acknowledgedByUserId String?        @map("acknowledged_by_user_id") @db.Uuid
  resolvedAt           DateTime?      @map("resolved_at") @db.Timestamptz(6)
  resolutionNote       String?        @map("resolution_note")
  lastNotifiedAt       DateTime?      @map("last_notified_at") @db.Timestamptz(6)
  escalatedAt          DateTime?      @map("escalated_at") @db.Timestamptz(6)
  postmortem           Json?
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  rule       AlertRule              @relation(fields: [organizationId, ruleId], references: [organizationId, id], onDelete: Cascade)
  events     IncidentEvent[]
  deliveries NotificationDelivery[]

  @@unique([organizationId, id])
  @@unique([organizationId, openFingerprint])
  @@index([organizationId, fingerprint, resolvedAt(sort: Desc)])
  @@index([organizationId, productId, status])
  @@map("alert_incidents")
}

model IncidentEvent {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  incidentId     String            @map("incident_id") @db.Uuid
  kind           IncidentEventKind
  detail         Json              @default("{}")
  at             DateTime          @default(now()) @db.Timestamptz(6)

  incident AlertIncident @relation(fields: [organizationId, incidentId], references: [organizationId, id], onDelete: Cascade)

  @@index([incidentId, at])
  @@map("incident_events")
}

model NotificationChannel {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String        @map("organization_id") @db.Uuid
  name                String
  kind                ChannelKind
  /// Non-secret settings (email recipients, host of a webhook URL for display).
  config              Json          @default("{}")
  /// Envelope-encrypted webhook URL or signing secret (AAD notification-channel:<id>).
  secret              String?
  escalation          Boolean       @default(false)
  status              ChannelStatus @default(active)
  consecutiveFailures Int           @default(0) @map("consecutive_failures")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   NotificationDelivery[]

  @@unique([organizationId, id])
  @@map("notification_channels")
}

model NotificationDelivery {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  channelId      String         @map("channel_id") @db.Uuid
  /// Null for test deliveries.
  incidentId     String?        @map("incident_id") @db.Uuid
  event          DeliveryEvent
  status         DeliveryStatus @default(pending)
  attempts       Int            @default(0)
  lastError      String?        @map("last_error")
  sentAt         DateTime?      @map("sent_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  channel  NotificationChannel @relation(fields: [organizationId, channelId], references: [organizationId, id], onDelete: Cascade)
  incident AlertIncident?      @relation(fields: [organizationId, incidentId], references: [organizationId, id], onDelete: Cascade)

  @@index([channelId, createdAt(sort: Desc)])
  @@map("notification_deliveries")
}

