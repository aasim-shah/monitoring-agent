  product    Product          @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)
  schedule   ReportSchedule?  @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  deliveries ReportDelivery[]

  @@unique([scheduleId, localDate, version])
