/// A daily report schedule (WB-15 UC-15-01); next_run_at is the UTC instant of the next local run.
model ReportSchedule {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  environmentId   String?  @map("environment_id") @db.Uuid
  name            String
  template        String   @default("daily")
  /// IANA timezone, e.g. Europe/Berlin.
  timezone        String
  /// Local wall time HH:MM.
  localTime       String   @map("local_time")
  channelIds      String[] @default([]) @map("channel_ids") @db.Uuid
  recipients      String[] @default([])
  enabled         Boolean  @default(true)
  nextRunAt       DateTime @map("next_run_at") @db.Timestamptz(6)
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
