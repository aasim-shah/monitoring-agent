{
  "name": "@pcp/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "bin": {
    "pcp-db": "./dist/cli.js"
  },
  "files": [
    "dist",
    "generated",
    "prisma"
  ],
  "scripts": {
    "generate": "prisma generate --schema prisma/schema.prisma",
    "build": "prisma generate --schema prisma/schema.prisma && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate --schema prisma/schema.prisma && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "prisma generate --schema prisma/schema.prisma && vitest run"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "pg": "8.16.3",
    "prisma": "6.19.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "11.14.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.15.6",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
