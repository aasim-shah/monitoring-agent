# Production TLS configuration (spec §17.3, master plan D10).
# app.    dashboard + user API + webhooks
# agent.  agent control channel, mTLS required
# ingest. telemetry ingest, mTLS required
{
	email {$ACME_EMAIL}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# Ingest: every request must present an agent certificate.
(agent_mtls) {
	tls {
		client_auth {
			mode require_and_verify
			trust_pool file /etc/caddy-agent-ca/chain.pem
		}
	}
}

# Control channel: a certificate is verified when presented, but not required, because
# POST /agent/v1/enroll runs before the agent has one. The API rejects every other agent
# route without a forwarded fingerprint (M5 ruling on D10).
(agent_mtls_optional) {
	tls {
		client_auth {
			mode verify_if_given
			trust_pool file /etc/caddy-agent-ca/chain.pem
		}
	}
}

{$APP_DOMAIN} {
	import security_headers
	encode zstd gzip
	request_header -X-Client-Cert-Fingerprint

	handle /api/* {
		reverse_proxy api:3000
	}

	handle /webhooks/* {
		reverse_proxy api:3000
	}

	# Agent installer and release artifacts (M6.7).
	@downloads path /install.sh /downloads/*
	handle @downloads {
		reverse_proxy downloads:8080
	}

	handle {
		reverse_proxy web:3001
	}
}

{$AGENT_DOMAIN} {
	import agent_mtls_optional
	request_header -X-Client-Cert-Fingerprint
	import security_headers

	handle /agent/v1/opamp* {
		reverse_proxy opamp-server:4320 {
			header_up X-Client-Cert-Fingerprint {http.request.tls.client.fingerprint}
		}
	}

	handle /agent/v1/* {
		reverse_proxy api:3000 {
			header_up X-Client-Cert-Fingerprint {http.request.tls.client.fingerprint}
		}
	}

	handle {
		respond 404
	}
}

{$INGEST_DOMAIN} {
	import agent_mtls
	request_header -X-Client-Cert-Fingerprint
	import security_headers

	reverse_proxy ingest-gateway:4318 {
		header_up X-Client-Cert-Fingerprint {http.request.tls.client.fingerprint}
	}
}
