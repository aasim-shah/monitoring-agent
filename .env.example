# Product Control Plane — environment template. Copy to .env and fill in secrets.

# Deployment mode: managed | self_hosted (master plan D1)
DEPLOYMENT_MODE=managed

# Bootstrap: private_http serves HTTP for first-admin setup; agent enrollment,
# OAuth, and webhooks stay disabled until HTTPS (D2). Set CADDY_CONFIG to
# Caddyfile.production once domains and the agent CA chain exist.
BOOTSTRAP_MODE=private_http
CADDY_CONFIG=Caddyfile.bootstrap

# Published ports (only Caddy publishes)
HTTP_PORT=8080
HTTPS_PORT=8443

# Production domains (Caddyfile.production)
APP_DOMAIN=app.example.com
AGENT_DOMAIN=agent.example.com
INGEST_DOMAIN=ingest.example.com
ACME_EMAIL=ops@example.com
# Directory containing chain.pem for the agent intermediate CA
AGENT_CA_DIR=./infrastructure/caddy/agent-ca

# Public URL of the dashboard (used in emails and Origin checks)
APP_ORIGIN=http://localhost:8080

# Email (verification, reset, invitations). Without SMTP_URL no mail is sent.
SMTP_URL=
MAIL_FROM=Product Control Plane <no-reply@example.com>

# Secrets — required. Database and Redis passwords must be URL-safe: openssl rand -hex 32
POSTGRES_SUPERUSER_PASSWORD=
PCP_MIGRATOR_PASSWORD=
PCP_APP_PASSWORD=
PCP_SCHEDULER_PASSWORD=
REDIS_PASSWORD=
# 32 random bytes, base64: openssl rand -base64 32. Back it up separately; losing it
# makes stored secrets (MFA, connector credentials) unrecoverable.
MASTER_KEY=

# --- Agent enrollment (M5). Set all of these, or none (enrollment then answers 503). ---
# Generate with: pnpm --filter @pcp/api agent:pki --out ./.pki   (prints the four PEM lines)
AGENT_CA_CERT=
AGENT_CA_KEY=
AGENT_CA_CHAIN=
TASK_SIGNING_KEY=
AGENT_CONTROL_URL=https://agent.example.com
AGENT_INGEST_URL=https://ingest.example.com
AGENT_OPAMP_URL=wss://agent.example.com/agent/v1/opamp

# Edge network: Caddy gets a fixed address so the API trusts certificate headers only from it.
# Change both when another Docker network already uses this range.
EDGE_SUBNET=172.30.0.0/24
CADDY_ADDRESS=172.30.0.10
