# Product Control Plane — environment template. Copy to .env and fill in secrets.

# Deployment mode: managed | self_hosted (master plan D1)
DEPLOYMENT_MODE=managed

# Bootstrap: private_http serves HTTP for first-admin setup; agent enrollment,
# OAuth, and webhooks stay disabled until HTTPS (D2). Set CADDY_CONFIG to
# Caddyfile.production once domains and the agent CA chain exist.
BOOTSTRAP_MODE=private_http
CADDY_CONFIG=Caddyfile.bootstrap

# Published ports (only Caddy publishes)
HTTP_PORT=8080
HTTPS_PORT=8443

# Production domains (Caddyfile.production)
APP_DOMAIN=app.example.com
AGENT_DOMAIN=agent.example.com
INGEST_DOMAIN=ingest.example.com
ACME_EMAIL=ops@example.com
# Directory containing chain.pem for the agent intermediate CA
AGENT_CA_DIR=./infrastructure/caddy/agent-ca

# Public URL of the dashboard (used in emails and Origin checks)
APP_ORIGIN=http://localhost:8080

# Email (verification, reset, invitations). Without SMTP_URL no mail is sent.
SMTP_URL=
MAIL_FROM=Product Control Plane <no-reply@example.com>

# Secrets — required. Database and Redis passwords must be URL-safe: openssl rand -hex 32
POSTGRES_SUPERUSER_PASSWORD=
PCP_MIGRATOR_PASSWORD=
PCP_APP_PASSWORD=
PCP_SCHEDULER_PASSWORD=
REDIS_PASSWORD=
# 32 random bytes, base64: openssl rand -base64 32. Back it up separately; losing it
# makes stored secrets (MFA, connector credentials) unrecoverable.
MASTER_KEY=
# Shared secret for private-network service calls (ingest gateway → API): openssl rand -hex 32
INTERNAL_TOKEN=

# --- Agent enrollment (M5). Set all of these, or none (enrollment then answers 503). ---
# Generate with: pnpm --filter @pcp/api agent:pki --out ./.pki   (prints the four PEM lines)
AGENT_CA_CERT=
AGENT_CA_KEY=
AGENT_CA_CHAIN=
TASK_SIGNING_KEY=
AGENT_CONTROL_URL=https://agent.example.com
AGENT_INGEST_URL=https://ingest.example.com
AGENT_OPAMP_URL=wss://agent.example.com/agent/v1/opamp

# Edge network: Caddy gets a fixed address so the API trusts certificate headers only from it.
# Change both when another Docker network already uses this range.
EDGE_SUBNET=172.30.0.0/24
CADDY_ADDRESS=172.30.0.10

# AI provider (M14): gemini | groq | openrouter. Leave keys empty to disable the assistant.
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
AI_FALLBACK_PROVIDER=groq
AI_FALLBACK_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Google OAuth client (sign-in and Google data connections). Set all three or none.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Self-hosted options (M19.4) ---
# Sign-in through your own OpenID Provider (Keycloak, Authentik, Entra ID, Okta). Set the four or none.
# Redirect URI to register at the provider: https://<APP_DOMAIN>/api/v1/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_DISPLAY_NAME=Single sign-on
# AI on your own hardware: any OpenAI-compatible endpoint (Ollama, vLLM, LM Studio).
#   AI_PROVIDER=local  AI_MODEL=llama3.1:8b  AI_LOCAL_BASE_URL=http://ollama:11434/v1
AI_LOCAL_BASE_URL=
AI_LOCAL_API_KEY=
# Run without any AI (the assistant is off and reports have no narrative).
AI_DISABLED=0

# --- Optional services (M17, M18) ---
# Assisted SSH install (installer-runner): the egress IPs customers allowlist, comma-separated.
INSTALLER_EGRESS_IPS=
# Retained logs: start the `logs` profile and set VLOGS_URL=http://victorialogs:9428 (7 days).
VLOGS_URL=
# Long-term rollups: start the `rollups` profile, then set both (ROLLUPS_SINCE = when you started it).
VM_LONGTERM_URL=
ROLLUPS_SINCE=

# Optional AWS connector: the platform needs permission to sts:AssumeRole customer roles.
# Prefer a workload IAM role in production. For local Docker, supply platform credentials here.
# Customer connections use role ARNs + generated external IDs; never customer access keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
